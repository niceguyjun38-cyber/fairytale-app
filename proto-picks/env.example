# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (copy env.example .env)

# Claude API 키 (축구 외 종목 웹 리서치 + 한글 팀명 매칭). 없으면 축구 FotMob 분석만 동작
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high : 높을수록 리서치가 꼼꼼하지만 비용 증가
CLAUDE_EFFORT=medium
# 하루 리서치 최대 경기 수 (비용 상한)
MAX_RESEARCH_FIXTURES=24

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 추천 규칙
# 조합 1개당 경기 수 (7폴더)
LEGS_PER_COMBO=7
# 안전 B가 안전 A와 같이 쓰는 경기 수 (나머지는 다른 경기로 교체)
SAFE_B_SHARED=4
# 모험 A / 모험 B에 넣을 고배당(가치) 경기 수
RISKY_A_VALUE=2
RISKY_B_VALUE=3
# 이보다 낮은 배당은 제외
MIN_LEG_ODDS=1.15
LOOKAHEAD_HOURS=36
MAX_PER_LEAGUE=3

# 확률 혼합 가중치 (모델 vs 배당)
MODEL_WEIGHT_SOCCER=0.30
MODEL_WEIGHT_OTHER=0.35
MOVEMENT_FACTOR=0.6
