# 이 파일을 .env 로 복사한 뒤 값을 채우세요.  (copy env.example .env)

# Claude API 키 (축구 외 종목 웹 리서치 + 한글 팀명 매칭). 없으면 축구 FotMob 분석만 동작
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high : 높을수록 리서치가 꼼꼼하지만 비용 증가
CLAUDE_EFFORT=medium
# 하루 리서치 최대 경기 수 (비용 상한)
MAX_RESEARCH_FIXTURES=24

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 추천 규칙
PICKS_COUNT=7
SAFE_LEGS=3
RISKY_LEGS=4
SAFE_MIN_ODDS=2.0
RISKY_MIN_ODDS=5.0
LOOKAHEAD_HOURS=36
MAX_PER_LEAGUE=3

# 확률 혼합 가중치 (모델 vs 배당)
MODEL_WEIGHT_SOCCER=0.40
MODEL_WEIGHT_OTHER=0.35
MOVEMENT_FACTOR=0.6
